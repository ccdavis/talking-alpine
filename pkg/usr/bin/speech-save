#!/bin/sh
# Save the system state (packages installed with apk add, everything under
# /etc, the tdsr config) to the stick so it is there after a reboot.
# Downloaded packages are already in the stick's cache; lbu records which
# ones to install at boot.
if [ "$(id -u)" != 0 ]; then
	exec doas /usr/bin/speech-save "$@"
fi
if [ -e /etc/speech/installed ]; then
	echo "This system is installed on a disk: changes are kept without saving."
	exit 0
fi
echo "Saving system state to the stick..."
lbu commit -d && echo "Done. Packages and settings will be restored at the next boot."
