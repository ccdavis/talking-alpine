#!/bin/sh
# Install packages from the network and keep them on the stick:
#   speech-install irssi links
# (apk update, apk add, then speech-save so the packages and the world list
# are restored at the next boot from the stick's cache, no network needed.)
[ $# -gt 0 ] || { echo "usage: speech-install package..."; exit 1; }
doas apk update && doas apk add "$@" || exit 1
[ -e /etc/speech/installed ] || exec /usr/bin/speech-save
